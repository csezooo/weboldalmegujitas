---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Kapcsolat | weboldalmegujitas.hu" description="Lépj kapcsolatba velünk e-mailben vagy Facebookon.">
  <section class="bg-base pt-52 pb-50">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">Kapcsolat</span>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Lépj kapcsolatba velünk</h1>
      <p class="mt-5 text-muted">
        Keress minket bátran e-mailben vagy Facebookon — igyekszünk hamar válaszolni.
      </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-6">        
        <a
          href="mailto:info@weboldalmegujitas.hu"
          class="flex items-center gap-3 rounded-full border border-line px-7 py-3.5 text-sm font-semibold text-white transition-colors duration-300 ease-out hover:border-accent hover:text-accent"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          info@weboldalmegujitas.hu
        </a>

        <a
          href="https://www.facebook.com/weboldalmegujitas.hu"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-full border border-line px-7 py-3.5 text-sm font-semibold text-white transition-colors duration-300 ease-out hover:border-accent hover:text-accent"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z" />
          </svg>
          Facebook
        </a>
      </div>
    </div>
  </section>
</Layout>