---
import { Image } from 'astro:assets';
import hero from '../assets/kepek/hero.png';
import reasonBg from '../assets/kepek/reasonbg.jpg';
import refiidekor from '../assets/kepek/idekor.png';
import refiprevencio from '../assets/kepek/prevenciolatascentrum.png';
import refiilonaszabo from '../assets/kepek/ilonaszabo.png';
import rolunk from '../assets/kepek/rolunk.png';
import folyamat from '../assets/kepek/folyamat.png';
import Layout from '../layouts/Layout.astro';

const problems = [
  {
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    title: 'Lassú betöltés',
    text: 'Az emberek 45%-a elhagyja az oldalt, ha az 3 másodpercnél több ideig tölt be. Ha 5 másodpercig, ez a szám akár a 90%-ot is elérheti.',
  },
  {
    icon: 'M4 4h16v16H4V4zm4 4h8m-8 4h8m-8 4h4',
    title: 'Elavult dizájn',
    text: 'A weboldalad a vállalkozásod online kirakata. Egy elavult megjelenéssel rendelkező oldal ma már bizalmatlanságot kelt szakértelem helyett.',
  },
  {
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
    title: 'Nem mobilbarát',
    text: 'A látogatók kb. 70%-a mobilról érkezik, ha a weboldalad ott nem átlátható jóval kevesebben fognak megkeresni.',
  },
  {
    icon: 'M9 19v-6a2 2 0 012-2h2a2 2 0 012 2v6m-9 0h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z',
    title: 'Nem hoz megkeresést',
    text: 'Szép oldal ügyfelek nélkül semmit sem ér, ha nincs egyértelmű út a jelentkezésig, és erre nincsenek emlékeztetve.',
  },
];

const steps = [
  ['01', 'Árajánlat', 'Kitöltöd az ajánlatkérő űrlapot, mi pedig átnézzük a jelenlegi weboldaladat. <br><br>Megvizsgáljuk többek között a megjelenést, a mobilos használhatóságot, a sebességet, a felépítést és az alapvető SEO-szempontokat. Ezután emailben elküldjük az audit eredményét és a javasolt megújítás részleteit, a várható költségekkel együtt.'],
  ['02', 'Egyeztetés', 'Ha megfelelőnek találod az ajánlatot, egyeztetjük a pontos elképzeléseidet. <br><br>Megbeszéljük, mely részeket szeretnéd megtartani, min szeretnél változtatni, milyen új funkciókra van szükség, és milyen irányba szeretnéd elvinni a weboldal megjelenését.'],
  ['03', 'Megújítás', 'Az egyeztetett terv alapján megkezdjük a weboldal átalakítását. <br><br>Modernizáljuk a megjelenést, javítjuk a felépítést, optimalizáljuk a sebességet és reszponzívvá tesszük az oldalt. A cél nem egyszerűen egy szebb weboldal, hanem egy átgondoltabb és hatékonyabb online felület.'],
  ['04', 'Átadás & támogatás', 'Az elkészült weboldalt véglegesítjük és élesítjük. <br><br>Az átadás után sem engedjük el a kezed. Ha szeretnéd, folyamatos karbantartással, frissítésekkel, biztonsági mentésekkel és hibajavítással is gondoskodunk arról, hogy a weboldalad hosszú távon megfelelően működjön.'],
];

const benefits = [
  ['Modern, egyedi design', 'Olyan megjelenés, ami szakértelmet és bizalmat sugall már az első pillanatban.'],
  ['Villámgyors betöltés', 'Optimalizált weboldal teljesítméy, hogy a látogatóid ne várjanak feleslegesen.'],
  ['Mobilbarát megjelenés', 'Tökéletes élmény minden eszközön — telefonon, tableten és asztali gépen is.'],
  ['SEO alapok', 'Kereső­optimalizált szerkezet, hogy a Google-ben is könnyebben megtaláljanak.'],
  ['Könnyen kezelhető', 'Egyszerű felület, ha te magad szeretnél frissíteni egy-egy tartalmat.'],
  ['Folyamatos támogatás', 'Nem hagyunk magadra az élesítés után sem — mellette maradunk.'],
];

const works = [
  { title: 'Donna Divat', tag: 'Weboldal megújítás', image: refiilonaszabo },
  { title: 'iDekor', tag: 'Weboldal megújítás, SEO', image: refiidekor },
  { title: 'Prevenció Látáscentrum', tag: 'Weboldal megújítás', image: refiprevencio },
];

const reasons = [
  ['Megmaradhat a SEO-érték', 'A weboldalad jelenlegi keresőoptimalizálása megmarad, így a keresőknek nem a 0-ról kell feltérképezni őket. A megfelelő átirányításokkal és technikai beállításokkal a már megszerzett érték jelentős része továbbvihető az új oldalra.'],
  ['Alacsonyabb költség', 'Ha a jelenlegi rendszer megfelelő alapot biztosít, nem szükséges mindent újra felépíteni. Így csak azokat a részeket alakítjuk át, amelyek valóban fejlesztésre vagy cserére szorulnak, ami jóval tárcabarátabb.'],
  ['Rövidebb átfutási idő', 'A meglévő tartalmak és struktúrák egy része tovább használható, így gyorsabban elkészülhet az új verzió. Nem kell minden elemet a nulláról megtervezni és felépíteni.'],
  ['Kisebb kockázat', 'A már működő elemeket megtarthatjuk, miközben fokozatosan javítjuk a problémás részeket. Így a megújítás során kisebb eséllyel vesznek el olyan funkciók vagy tartalmak, amelyekre szükséged van.'],
  ['Megszokott domain', 'Éppen keresőoptimalizálási szempontból mi nem ajánljuk, hogy a weboldalad új domainre kerüljön. A meglévő webcímed, amelyet ügyfeleid és partnereid már ismernek, továbbra is használható maradhat.'],
  ['Mégis teljesen új hatás', 'A látogatók számára egy modern, gyorsabb és átláthatóbb weboldal jelenik meg. A háttérben meglévő értékek megőrzése mellett a teljes felhasználói élmény és a megjelenés is jelentősen megújulhat.'],
];
---

<Layout>
  <!-- 1. HERO -->
  <section class="relative overflow-hidden border-b border-line bg-base pt-16 pb-24 md:pt-24 md:pb-32">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-accent/20 blur-[120px]"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-16 px-6 md:grid-cols-2">
      <div data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-1.5 text-xs font-medium uppercase tracking-wider text-accent tracking-widest">
          weboldalmegujitas.hu
        </span>

        <h1 class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-white md:text-5xl lg:text-6xl">
          Új életet lehelünk<br />
          <span class="bg-gradient-to-r from-accent to-accent-soft bg-clip-text text-transparent">a weboldaladba.</span>
        </h1>

        <h2 class="mt-6 max-w-lg text-lg text-muted">
          Meglévő weboldalakat újítjuk meg, és alakítunk át gyors, modern és ügyfeleket hozó oldallá.
        </h2>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#ajanlatkeres" class="rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white transition-all duration-500 ease-out hover:shadow-[0_0_25px_5px_rgba(255,77,46,0.35)]">
            Díjmentes árajánlatot kérek
          </a>

          <a href="/munkaink" class="rounded-full border border-line px-7 py-3.5 text-sm font-semibold text-white transition-colors duration-500 ease-out hover:border-white/40">
            Megnézem a munkáinkat
          </a>
        </div>

        <div class="mt-14 grid grid-cols-2 gap-6 sm:grid-cols-4">
          {['Modern & reszponzív', 'SEO optimalizált', 'Gyors betöltés', 'Könnyen kezelhető'].map((label) => (
            <div class="flex items-center gap-2 text-sm text-muted">
              <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
              {label}
            </div>
          ))}
        </div>
      </div>

      <div class="relative" data-reveal>
  <Image
    src={hero}
    alt="Weboldal megújítás - modern weboldal minden eszközön"
    class="mx-auto w-full max-w-lg rounded-2xl"
    widths={[500, 600, 800]}
    sizes="(max-width: 1000px) 90vw, 1000px"
  />
</div>
    </div>
  </section>

  <!-- 2. PROBLÉMA -->
  <section class="border-b border-line bg-base py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">
          A régi weboldalad többet árt, mint használ.
        </h2>
        <p class="mt-4 text-muted">
          Egy régi, lassú vagy nehezen kezelhető weboldal miatt akár ügyfeleket is veszíthetsz. A látogatók néhány másodperc alatt eldöntik, hogy maradnak-e az oldalon. Ha a weboldalad nem kelt bizalmat, nem működik megfelelően mobilon vagy túl lassan tölt be, könnyen lehet, hogy a potenciális ügyfél inkább egy konkurenst választ.
        </p>
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {problems.map((item) => (
          <div
            data-reveal
            class="group rounded-2xl border border-line bg-surface p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-accent/40"
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-accent/10 text-accent transition-colors duration-300 ease-out group-hover:bg-accent group-hover:text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </div>
            <h3 class="mt-4 font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm text-muted" set:html={item.text} />
          </div>
        ))}
      </div>

      <div class="mt-14 text-center" data-reveal>
        <a href="#ajanlatkeres" class="inline-block rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 ease-out hover:shadow-[0_0_25px_5px_rgba(255,77,46,0.35)]">
          Kérek egy ingyenes állapotfelmérést
        </a>
      </div>
    </div>
  </section>

  <!-- 3. FOLYAMAT -->
  <section class="border-b border-line bg-surface/40 py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Folyamat</span>
        <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">Így dolgozunk együtt</h2>
        <p class="mt-4 text-muted">Átlátható, lépésről lépésre haladó folyamat — mindig tudod, hol tartunk.</p>
      </div>

      <div class="mt-16 grid gap-12 md:grid-cols-2 md:items-start">
        <div class="space-y-1" data-reveal>
          {steps.map(([num, title, text], index) => (
            <div class:list={["process-item", { "is-open": index === 0 }]}>
              <button type="button" class="process-toggle group flex w-full items-center gap-4 py-4 text-left">
                <span class="process-number flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-sm font-bold text-accent">
                  {num}
                </span>
                <span class="process-title font-semibold text-white">{title}</span>
                <span class="h-px flex-1 bg-line"></span>
                <svg class:list={["process-chevron h-4 w-4 shrink-0 text-muted transition-transform duration-300 ease-out", { "rotate-180": index === 0 }]} viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.3 7.3a1 1 0 011.4 0L10 10.6l3.3-3.3a1 1 0 111.4 1.4l-4 4a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4z" clip-rule="evenodd" />
                </svg>
              </button>
              <div class:list={["process-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out", { "is-open": index === 0 }]}>
                <div class="overflow-hidden">
                  <p class="pb-5 pl-[52px] text-sm leading-relaxed text-muted" set:html={text} />
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="relative md:sticky md:top-24" data-reveal>
          <Image
            src={folyamat}
            alt="Weboldal megújítási folyamat"
            class="mx-auto w-full max-w-sm rounded-2xl"
          />
        </div>
      </div>
    </div>
  </section>

<script>
    const items = document.querySelectorAll('.process-item');
    items.forEach((item) => {
      const toggle = item.querySelector('.process-toggle');
      toggle?.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        items.forEach((other) => {
          other.classList.remove('is-open');
          other.querySelector('.process-panel')?.classList.remove('is-open');
          other.querySelector('.process-chevron')?.classList.remove('rotate-180');
        });

        if (!isOpen) {
          item.classList.add('is-open');
          item.querySelector('.process-panel')?.classList.add('is-open');
          item.querySelector('.process-chevron')?.classList.add('rotate-180');
        }
      });
    });
  </script>

  <!-- 4. MIT KAPSZ -->
  <section class="border-b border-line bg-base py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Eredmény</span>
        <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">Mit kapsz a weboldal megújításával?</h2>
        <p class="mt-4 text-muted">Nem csak szebb oldalt — mérhető eredményeket.</p>
      </div>

      <div class="mt-16 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {benefits.map(([title, text]) => (
          <div class="flex gap-4" data-reveal>
            <div class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">{title}</h3>
              <p class="mt-1 text-sm text-muted">{text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. MIÉRT ÉRI MEG FELÚJÍTANI -->
  <section class="relative overflow-hidden border-b border-line py-24">
    <div class="reason-bg pointer-events-none absolute inset-0 -z-10">
  <Image
    src={reasonBg}
    alt="Miért éri meg felújítani a weboldalad? weboldalmegujitas"
    class="h-full w-full scale-100 object-cover"
  />
  <div class="absolute inset-0 bg-base/20"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-base via-base/40 to-base/100"></div>
</div>

    <div class="mx-auto grid max-w-7xl items-center gap-16 px-6 md:grid-cols-2">
      <div data-reveal>
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Miért mi?</span>
        <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">
          Miért jobb megújítani, mint nulláról kezdeni?
        </h2>
        <p class="mt-5 text-muted">
          Egy meglévő weboldal nem csupán néhány oldalból és képből áll. <br><br>A domainnek lehet már előzménye a keresőkben, a weboldalt ismerhetik a meglévő ügyfeleid, és a vállalkozásod online jelenléte is erre az oldalra épülhet. Egy teljesen új weboldal indításakor ezek egy részét újra kell építeni. <br><br> A megújítás lehetőséget ad arra, hogy megtartsuk azt, ami értékes, miközben lecseréljük azt, ami már nem működik megfelelően.
        </p>
      </div>

      <div class="flex items-center gap-4" data-reveal>
        <div class="reason-carousel relative h-40 flex-1 overflow-hidden sm:h-42">
          {reasons.map(([title, text], index) => (
            <div class:list={["reason-slide absolute inset-0 flex flex-col items-end justify-center text-right", { "is-active": index === 0 }]} data-index={index}>
              <h3 class="text-xl font-bold text-white sm:text-2xl">{title}</h3>
              <p class="mt-2 max-w-sm text-sm text-muted">{text}</p>
            </div>
          ))}
        </div>

        <div class="flex shrink-0 flex-col gap-2">
          <button type="button" class="reason-prev flex h-10 w-10 items-center justify-center rounded-full border border-line text-white transition-colors duration-300 ease-out hover:border-accent hover:text-accent" aria-label="Előző pont">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M14.7 12.7a1 1 0 01-1.4 0L10 9.4l-3.3 3.3a1 1 0 01-1.4-1.4l4-4a1 1 0 011.4 0l4 4a1 1 0 010 1.4z" clip-rule="evenodd" /></svg>
          </button>
          <button type="button" class="reason-next flex h-10 w-10 items-center justify-center rounded-full border border-line text-white transition-colors duration-300 ease-out hover:border-accent hover:text-accent" aria-label="Következő pont">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.3 7.3a1 1 0 011.4 0L10 10.6l3.3-3.3a1 1 0 111.4 1.4l-4 4a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4z" clip-rule="evenodd" /></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
  const carousel = document.querySelector('.reason-carousel');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll('.reason-slide'));
    const prevBtn = document.querySelector('.reason-prev');
    const nextBtn = document.querySelector('.reason-next');
    let current = 0;
    let timer;

    function goTo(index) {
      const currentSlide = slides[current];
      currentSlide.classList.remove('is-active');
      currentSlide.classList.add('is-exiting');

      const nextSlide = slides[index];
      nextSlide.classList.add('is-active');

      setTimeout(() => {
        currentSlide.classList.remove('is-exiting');
      }, 600);

      current = index;
    }

    function next() {
      goTo((current + 1) % slides.length);
    }

    function prev() {
      goTo((current - 1 + slides.length) % slides.length);
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(next, 5000);
    }

    nextBtn?.addEventListener('click', () => { next(); resetTimer(); });
    prevBtn?.addEventListener('click', () => { prev(); resetTimer(); });

    resetTimer();
  }
</script>

  <!-- 6. MUNKÁINK -->
  <section class="border-b border-line bg-base py-24 pb-50">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Munkáink</span>
        <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">Korábbi munkáink</h2>
        <p class="mt-4 text-muted">Néhány projekt, amit megújítottunk.</p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {works.map((project) => (
          <a href="/munkaink" class="group block overflow-hidden rounded-2xl border border-line bg-surface" data-reveal>
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={project.image}
                alt={project.title}
                class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              />
            </div>            
            <div class="flex items-center justify-between p-5">
              <div>
                <h3 class="font-semibold text-white">{project.title}</h3>
                <p class="mt-1 text-xs text-muted">{project.tag}</p>
              </div>
              <svg class="h-4 w-4 text-accent transition-transform duration-300 ease-out group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.3 3.3a1 1 0 011.4 0l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4L13.6 10 10.3 6.7a1 1 0 010-1.4z" clip-rule="evenodd" /></svg>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center" data-reveal>
        <a href="/munkaink" class="inline-block rounded-full border border-line px-7 py-3.5 text-sm font-semibold text-white transition-colors duration-300 ease-out hover:border-white/40">
          Összes munkánk megtekintése
        </a>
      </div>
    </div>
  </section>

 <!-- 7. KARBANTARTÁS ÁTÍVELÉS -->
  <div class="relative z-10 mx-auto -mt-25 -mb-0 max-w-6xl px-6">
    <div class="rounded-3xl bg-accent px-8 py-10 shadow-xl sm:px-12" data-reveal>
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-white/80">Utána sem hagyunk magadra</span>
          <h2 class="mt-2 text-2xl font-bold text-white sm:text-3xl">Folyamatosan karbantartjuk a weboldaladat</h2>
          <p class="mt-3 max-w-xl text-sm text-white/90">
