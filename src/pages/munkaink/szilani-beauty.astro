---
import Layout from '../../layouts/Layout.astro';

const problems = [
  { icon: 'M7 21h10a2 2 0 002-2V9.5L14.5 4H7a2 2 0 00-2 2v13a2 2 0 002 2z', title: 'Nem volt mobilbarát', text: 'A látogatók jelentős része mobilonról érkezik és sajnos a weboldal nem volt mobilra optimalizálva. A teljes mobilos megjelenése el volt csúszva, így a látogatók nagy része már az első pillanatokban otthagyta az oldalt.' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'Nem volt CTA', text: 'A látogató sokszor nem tudta, mi a következő lépés. Az oldalon nem volt feltüntetve semmilyen "Hívj most!" vagy "Vedd fel velünk a kapcsolatot" gomb. Így a weboldal igazából céltalan volt.' },
  { icon: 'M4 6h16M4 12h16M4 18h7', title: 'Túlzsúfolt tartalom', text: 'Az oldal weboldal tartalma egyáltalán nem volt tördelve. A szolgáltatásleírások hosszú, tagolatlan szövegblokkokban jelentek meg, ami megnehezítette a gyors tájékozódást és az információ célba jutását.' },
];

const solutions = [
  'Új képi elemek kerültek be az oldal egészébe, illeszkedve a szépségipari szegmenshez.',
  'Átdolgoztuk és bővítettük a szolgáltatásleírásokat, hogy könnyen fogyaszthatók legyenek.',
  'CTA elemeket helyeztünk el több ponton az oldalon.',
  'Mobilbaráttá tettük a teljes weboldalt.',
  'Alapvető SEO-szempontokat építettünk be a struktúrába és a tartalmakba.',
];

const stats = [
  { value: 35, suffix: '+', label: 'Megújított aloldal' },
  { value: 300, suffix: '+', label: 'Online időpontfoglalás' },
  { value: 100, suffix: '%', label: 'Mobilbarát élmény' },
  { value: 10000, suffix: '+', label: 'Több szó a weboldalon' },
];
---

<Layout
  title="Szilani Beauty | Munkáink"
  description="Hogyan alakítottunk át egy nehezen átlátható weboldalt egy ügyfélszerző rendszerré."
>
    <!-- FEJLÉC + SZÁMLÁLÓK -->
  <section class="border-b border-line bg-base py-24">
    <div class="mx-auto grid max-w-5xl items-center gap-16 px-6 md:grid-cols-2">
      <div>
        <a href="/munkaink" class="inline-flex items-center gap-2 text-sm text-muted transition-colors duration-300 ease-out hover:text-white">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.7 16.7a1 1 0 01-1.4 0l-5-5a1 1 0 010-1.4l5-5a1 1 0 011.4 1.4L6.4 10l3.3 3.3a1 1 0 010 1.4z" clip-rule="evenodd" /></svg>
          Vissza a munkáinkhoz
        </a>

        <span class="mt-6 block text-xs font-semibold uppercase tracking-wider text-accent">Weboldal megújítás</span>
        <h1 class="mt-2 text-4xl font-bold text-white md:text-5xl">Szilani Beauty</h1>
        <p class="mt-4 text-lg text-muted">
          Hogyan alakítottunk át egy nehezen átlátható weboldalt egy ügyfélszerző rendszerré.
        </p>

        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-muted">
          <span><span class="text-white">Iparág:</span> Szépségipar, szépségszalon</span>
          <span><span class="text-white">Helyszín:</span> Budapest, Nagytarcsa, Hévíz</span>
          <a href="https://szilani-beauty.hu/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">szilani-beauty.hu</a>
        </div>
      </div>

      <div>
        <div class="stat-carousel relative h-32">
          {stats.map((stat, index) => (
            <div class:list={["stat-slide absolute inset-0 flex flex-col items-end justify-center text-right", { "is-active": index === 0 }]} data-index={index}>              <p class="stat-number text-5xl font-bold text-accent md:text-6xl" data-target={stat.value} data-suffix={stat.suffix}>{`0${stat.suffix}`}</p>
              <p class="mt-3 text-sm text-muted">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- REACHOUT -->
  <section class="bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">A kezdet</span>
          <h2 class="mt-2 text-2xl font-bold text-white">Amikor mi kerestünk meg egy ügyfelet</h2>
        </div>
        <div class="space-y-4 text-muted">
          <p>
            A legtöbb projektünk úgy indul, hogy egy vállalkozó keres meg minket. Ez a
            projekt kivétel volt: miután végignéztük a weboldalt, egyértelműen látszott,
            hogy jelenlegi állapotában ügyfeleket veszít miatta. A szolgáltatások és
            információk teljesen strukturálatlanul, ömlesztve jelentek meg — inkább egy
            hosszú, folyamatos szöveges dokumentumra hasonlított, mint egy modern,
            vizuálisan tagolt weboldalra.
          </p>
          <p>
            Egy online hívás keretében bemutattuk a gyengeségeket, konkrét példákkal
            illusztrálva, hol vesznek el potenciális vendégek — majd azt is, milyen
            irányba kellene elmozdulni: átláthatóbb struktúra, erősebb vizuális
            kommunikáció, és egy felhasználói út, ami magától vezeti el a látogatót az
            időpontfoglalásig.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLÉMÁK - KÁRTYÁK -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">A kiindulási helyzet</span>
      <h2 class="mt-2 text-2xl font-bold text-white">Amivel a régi weboldal küzdött</h2>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {problems.map((item) => (
          <div class="flex gap-4 rounded-2xl border border-line bg-base p-5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">{item.title}</h3>
              <p class="mt-1 text-sm text-muted">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MEGOLDÁS -->
  <section class="border-t border-line bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">A megoldás</span>
          <h2 class="mt-2 text-2xl font-bold text-white">Teljes újragondolás</h2>
        </div>
        <div>
          <p class="text-muted">
            A cél nem egy egyszerű "szebb dizájn" volt, hanem egy célirányos rendszer,
            amely bizalmat épít és aktívan támogatja az időpontfoglalást — úgy, hogy közben
            az eredeti márkaidentitást megtartottuk.
          </p>
          <ul class="mt-6 space-y-3">
            {solutions.map((text) => (
              <li class="flex items-start gap-3 text-sm text-white/90">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                {text}
              </li>
            ))}
          </ul>
          <p class="mt-6 rounded-xl border border-line bg-surface px-5 py-4 text-sm text-muted">
            Összesen <span class="font-semibold text-white">35+ aloldalt</span> újítottunk
            meg — gyakorlatilag a teljes weboldal tartalmi és strukturális átdolgozását
            jelentette, aloldalanként egyedi tartalommal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOGLALÁSI RENDSZER - KIEMELT IDÉZET-SZERŰ BLOKK -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="rounded-3xl border border-accent/30 bg-base p-8 sm:p-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Automatizáció</span>
        <h2 class="mt-2 text-2xl font-bold text-white">A foglalás néhány kattintás</h2>
        <p class="mt-4 text-muted">
          Az új weboldal elkészülte után a foglalási folyamatot is automatizáltuk:
          automatikus visszaigazoló e-mailek, teljes foglalási folyamat a szolgáltatás
          kiválasztásától az időpont megerősítéséig, és a fizetési információk automatikus
          kiküldése. Ennek eredményeként az együttműködés során{' '}
          <span class="font-semibold text-white">300+ online időpontfoglalás</span>{' '}
          érkezett a rendszeren keresztül.
        </p>
      </div>
    </div>
  </section>

  <!-- ÖSSZEGZÉS -->
  <section class="bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="border-l-2 border-accent pl-6 text-xl font-medium leading-relaxed text-white">
        „Nem egy bejövő megkeresésből indult, hanem abból a felismerésből, hogy egy jó
        szolgáltatás digitálisan alulteljesít — és ez hosszú távú együttműködéssé nőtte ki
        magát."
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="rounded-3xl border border-line bg-base px-8 py-10 text-center sm:px-12">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Neked is elkelne egy hasonló megújítás?</h2>
        <p class="mx-auto mt-3 max-w-md text-sm text-muted">
          Kérj egy ingyenes állapotfelmérést és árajánlatot — 24 órán belül jelentkezünk.
        </p>
        <a href="/#ajanlatkeres" class="mt-6 inline-block rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 ease-out hover:shadow-[0_0_25px_5px_rgba(255,77,46,0.35)]">
          Ingyenes árajánlatot kérek
        </a>
      </div>
    </div>
  </section>

  <script>
    const carousel = document.querySelector('.stat-carousel');
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll('.stat-slide'));
      let current = 0;

      function countUp(slide) {
        const numberEl = slide.querySelector('.stat-number');
        const target = parseInt(numberEl.dataset.target, 10);
        const suffix = numberEl.dataset.suffix || '';
        const duration = 3000;
        let start = null;

        function step(timestamp) {
          if (!start) start = timestamp;
          const progress = Math.min((timestamp - start) / duration, 1);
          const value = Math.floor(progress * target);
          numberEl.textContent = value + suffix;
          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            numberEl.textContent = target + suffix;
          }
        }
        requestAnimationFrame(step);
      }

      function goTo(index) {
        const currentSlide = slides[current];
        const nextSlide = slides[index];

        currentSlide.classList.remove('is-active');
        currentSlide.classList.add('is-exiting');
        nextSlide.classList.add('is-active');
        countUp(nextSlide);

        setTimeout(() => {
          currentSlide.classList.remove('is-exiting');
          currentSlide.querySelector('.stat-number').textContent = '0' + currentSlide.querySelector('.stat-number').dataset.suffix;
        }, 600);

        current = index;
      }

      countUp(slides[0]);

      setInterval(() => {
        goTo((current + 1) % slides.length);
      }, 5000);
    }
  </script>
</Layout>

</Layout>