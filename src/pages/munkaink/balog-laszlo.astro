---
import Layout from '../../layouts/Layout.astro';

const problems = [
  { icon: 'M4 4h16v16H4V4zm4 4h8m-8 4h8m-8 4h4', title: 'Elavult megjelenés', text: 'A design esztétikailag elavult volt, bár a tartalom rendezett és olvasható maradt.' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'Nincs CTA', text: 'A weboldalon nem voltak call-to-action elemek, amik a látogatót cselekvésre ösztönözték volna.' },
  { icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', title: 'Nincs időpontfoglalás', text: 'Az érdeklődők nem tudtak online, önállóan időpontot foglalni Lacihoz.' },
];

const solutions = [
  'Új, modern arculati terv Lacival közösen egyeztetve, majd bevezetve a teljes weboldalon',
  'CTA elemek beépítése több ponton, hogy a látogató mindig tudja, mi a következő lépés',
  'Bővített, részletesebb és rendezettebb tartalom a szolgáltatásokról',
  'Online időpontfoglalási rendszer a GoHighLevel widgetjeivel és rendszerével',
  'Kapcsolatfelvételi űrlap és blog-feliratkozási lehetőség beépítése',
  'Egyedi fejlesztésű Google Apps Script-alapú rendszer, ami valós időben mutatja, van-e még hely egy adott eseményen',
];

const stats = [
  { value: 15, suffix: '%', label: 'Teljesítménybeli javulás' },
  { value: 32, suffix: '%', label: 'Jobb SEO-audit' },
  { value: 15000, suffix: '', label: 'Új szó a tartalomban' },
  { value: 15, suffix: '', label: 'Új beépített foglalási / kapcsolati pont' },
];
---

<Layout
  title="Balog László | Munkáink"
  description="Modern megjelenés, online időpontfoglalás és egyedi eseménykezelő rendszer egy coach weboldalán."
>
  <!-- FEJLÉC + SZÁMLÁLÓK -->
  <section class="border-b border-line bg-base py-24">
    <div class="mx-auto grid max-w-5xl items-center gap-16 px-6 md:grid-cols-2">
      <div>
        <a href="/munkaink" class="inline-flex items-center gap-2 text-sm text-muted transition-colors duration-300 ease-out hover:text-white">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.7 16.7a1 1 0 01-1.4 0l-5-5a1 1 0 010-1.4l5-5a1 1 0 011.4 1.4L6.4 10l3.3 3.3a1 1 0 010 1.4z" clip-rule="evenodd" /></svg>
          Vissza a munkáinkhoz
        </a>

        <span class="mt-6 block text-xs font-semibold uppercase tracking-wider text-accent">Weboldal megújítás, időpontfoglalás</span>
        <h1 class="mt-2 text-4xl font-bold text-white md:text-5xl">Balog László</h1>
        <p class="mt-4 text-lg text-muted">
          Modern megjelenés, online időpontfoglalás és egyedi eseménykezelő rendszer egy
          coach weboldalán.
        </p>

        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-muted">
          <span><span class="text-white">Tevékenység:</span> Coaching</span>
          <a href="http://baloglaszlo.hu/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">baloglaszlo.hu</a>
        </div>
      </div>

      <div>
        <div class="stat-carousel relative h-32">
          {stats.map((stat, index) => (
            <div class:list={["stat-slide absolute inset-0 flex flex-col items-end justify-center text-right", { "is-active": index === 0 }]} data-index={index}>
              <p class="stat-number text-5xl font-bold text-accent md:text-6xl" data-target={stat.value} data-suffix={stat.suffix}>{`0${stat.suffix}`}</p>
              <p class="mt-3 text-sm text-muted">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- MEGKERESÉS -->
  <section class="bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">A megkeresés</span>
          <h2 class="mt-2 text-2xl font-bold text-white">Nem hiba, hanem fejlődés</h2>
        </div>
        <div class="space-y-4 text-muted">
          <p>
            László egyéni vállalkozóként coachinggal foglalkozik, és egy Facebook
            hirdetésünkből talált ránk. Az ő esete kicsit más volt, mint a legtöbb
            projektünk: a weboldalával technikailag nem volt gond — a képek rendezettek,
            a szövegek olvashatóak voltak, és az oldal technikailag is stabilan működött.
          </p>
          <p>
            László mégis úgy érezte, itt az idő a fejlődésre: új, modernebb megjelenést
            szeretett volna, és szerette volna beépíteni az online időpontfoglalás
            lehetőségét is, hogy az érdeklődők önállóan, gyorsan tudjanak vele időpontot
            egyeztetni.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLÉMÁK - KÁRTYÁK -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">A kiindulási helyzet</span>
      <h2 class="mt-2 text-2xl font-bold text-white">Amin fejlődni lehetett</h2>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {problems.map((item) => (
          <div class="rounded-2xl border border-line bg-base p-5">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </div>
            <h3 class="mt-4 font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MEGOLDÁS -->
  <section class="border-t border-line bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">A megoldás</span>
          <h2 class="mt-2 text-2xl font-bold text-white">Design, majd rendszer</h2>
        </div>
        <div>
          <p class="text-muted">
            Mivel a weboldal WordPress alapon, Elementorral épült, a weboldalépítőt
            felhasználva összeállítottunk egy arculati tervet, amit László elfogadott — az
            oldal aloldalai ez alapján kerültek megújításra.
          </p>
          <ul class="mt-6 space-y-3">
            {solutions.map((text) => (
              <li class="flex items-start gap-3 text-sm text-white/90">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                {text}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- EGYEDI FEJLESZTÉS - KIEMELT BLOKK -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="rounded-3xl border border-accent/30 bg-base p-8 sm:p-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Egyedi fejlesztés</span>
        <h2 class="mt-2 text-2xl font-bold text-white">Valós idejű helykijelzés eseményekre</h2>
        <p class="mt-4 text-muted">
          Az időpontfoglalási rendszer mellett egy egyedi, Google Apps Script-alapú
          megoldást is fejlesztettünk: ez a rendszer valós időben megmutatja a
          látogatónak, van-e még szabad hely az adott eseményen, mielőtt jelentkezne. A
          weboldalon keresztüli jelentkezési lehetőséget is ezzel a rendszerrel kötöttük
          össze, így László eseményeire is egyszerűen, önállóan lehet jelentkezni.
        </p>
      </div>
    </div>
  </section>

  <!-- ÖSSZEGZÉS -->
  <section class="border-t border-line bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="border-l-2 border-accent pl-6 text-xl font-medium leading-relaxed text-white">
        „Nem minden projekt egy problémás weboldal megmentéséről szól — Lacinál egy jól
        működő alapot fejlesztettünk tovább egy modern, funkciókban gazdagabb rendszerré."
      </p>
      <p class="mt-6 text-muted">
        A munka során körülbelül 15 aloldalt újítottunk meg, és nagyjából 15 000 szónyi új
        tartalommal bővítettük a weboldalt. Emellett 15 új online időpontfoglalási és
        kapcsolatfelvételi pontot építettünk be. A technikai optimalizálás (cache, képek,
        egyedi kódok) 15%-os teljesítménybeli javulást és 32%-kal jobb SEO-auditot
        eredményezett. László weboldalát azóta is folyamatosan karbantartjuk.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="rounded-3xl border border-line bg-base px-8 py-10 text-center sm:px-12">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Neked is elkelne egy hasonló megújítás?</h2>
        <p class="mx-auto mt-3 max-w-md text-sm text-muted">
          Kérj egy ingyenes állapotfelmérést és árajánlatot — 24 órán belül jelentkezünk.
        </p>
        <a href="/#ajanlatkeres" class="mt-6 inline-block rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 ease-out hover:shadow-[0_0_25px_5px_rgba(255,77,46,0.35)]">
          Ingyenes árajánlatot kérek
        </a>
      </div>
    </div>
  </section>

  <script>
    const carousel = document.querySelector('.stat-carousel');
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll('.stat-slide'));
      let current = 0;

      function countUp(slide) {
        const numberEl = slide.querySelector('.stat-number');
        const target = parseInt(numberEl.dataset.target, 10);
        const suffix = numberEl.dataset.suffix || '';
        const duration = 3000;
        let start = null;

        function step(timestamp) {
          if (!start) start = timestamp;
          const progress = Math.min((timestamp - start) / duration, 1);
          const value = Math.floor(progress * target);
          numberEl.textContent = value.toLocaleString('hu-HU') + suffix;
          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            numberEl.textContent = target.toLocaleString('hu-HU') + suffix;
          }
        }
        requestAnimationFrame(step);
      }

      function goTo(index) {
        const currentSlide = slides[current];
        const nextSlide = slides[index];

        currentSlide.classList.remove('is-active');
        currentSlide.classList.add('is-exiting');
        nextSlide.classList.add('is-active');
        countUp(nextSlide);

        setTimeout(() => {
          currentSlide.classList.remove('is-exiting');
          currentSlide.querySelector('.stat-number').textContent = '0' + currentSlide.querySelector('.stat-number').dataset.suffix;
        }, 600);

        current = index;
      }

      countUp(slides[0]);

      setInterval(() => {
        goTo((current + 1) % slides.length);
      }, 5000);
    }
  </script>
</Layout>