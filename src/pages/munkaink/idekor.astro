---
import Layout from '../../layouts/Layout.astro';

const problems = [
  { icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', title: 'Elavult motor', text: 'Régi WordPress verzió és WP Bakery builder, amit már nem célszerű továbbfejleszteni.' },
  { icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10', title: 'Túl sok bővítmény', text: 'Feleslegessé vált pluginok lassították jelentősen az oldalt.' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'Nincs gyorsítás', text: 'Cache-elés és sebesség-optimalizálás nem volt megoldva.' },
  { icon: 'M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z', title: 'Hiányos SEO', text: 'Nem volt PRO SEO plugin, ami korlátozta a technikai lehetőségeket.' },
];

const steps = [
  ['01', 'Staging környezet', 'A teljes átalakítást egy elkülönített felületen végeztük, hogy az élő oldal működése végig érintetlen maradjon.'],
  ['02', 'PHP-frissítés és teszt', 'A staging környezetben teszteltük, hogy az oldal képes-e futni egy modernebb, biztonságosabb szerverkörnyezetben — kiderült, hogy a régi motor nem volt kompatibilis.'],
  ['03', 'Plugin-tisztítás', 'Szisztematikusan átvizsgáltuk és megszűrtük a bővítményeket, letisztultabb, kevesebb erőforrást igénylő struktúrát hozva létre.'],
  ['04', 'Új megjelenés Elementorral', 'Az eredeti design alapkoncepcióját megtartva, modernizáltabb, jobban tagolt blokkstruktúrában építettük fel újra az oldalt.'],
];

const seoTasks = [
  'PRO SEO plugin (RankMath) telepítése és beállítása',
  'Kép alt-tagek kitöltése',
  'Schema.org mikroadatok hozzáadása és pontosítása',
  'Lokális SEO adatok, Open Graph beállítások és sitemap generálása',
  'A meglévő URL-struktúra megtartása, hogy a korábbi SEO-eredmények ne vesszenek el',
];

const stats = [
  { value: 22, suffix: '%', label: 'Oldalsebesség javulás' },
  { value: 35, suffix: '%', label: 'Technikai állapot javulás' },
  { value: 25, suffix: '%', label: 'Általános teljesítmény javulás' },
  { value: 5000, suffix: '+', label: 'Szó hozzáadása a weboldalhoz' },
  { value: 100, suffix: '%', label: 'Mobilbarát, esztétikus weboldal' },
];
---

<Layout
  title="iDekor | Munkáink"
  description="Egy elavult WP Bakery-s weboldal biztonságos, staging alapú megújítása."
>
  <!-- FEJLÉC + SZÁMLÁLÓK -->
  <section class="border-b border-line bg-base py-24">
    <div class="mx-auto grid max-w-5xl items-center gap-16 px-6 md:grid-cols-2">
      <div>
        <a href="/munkaink" class="inline-flex items-center gap-2 text-sm text-muted transition-colors duration-300 ease-out hover:text-white">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.7 16.7a1 1 0 01-1.4 0l-5-5a1 1 0 010-1.4l5-5a1 1 0 011.4 1.4L6.4 10l3.3 3.3a1 1 0 010 1.4z" clip-rule="evenodd" /></svg>
          Vissza a munkáinkhoz
        </a>

        <span class="mt-6 block text-xs font-semibold uppercase tracking-wider text-accent">Weboldal megújítás</span>
        <h1 class="mt-2 text-4xl font-bold text-white md:text-5xl">iDekor</h1>
        <p class="mt-4 text-lg text-muted">
          Egy elavult WP Bakery-s weboldal biztonságos, staging alapú megújítása.
        </p>

        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-muted">
          <span><span class="text-white">Iparág:</span> Reklámkivitelezés</span>
          <a href="https://idekor.hu/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">idekor.hu</a>
        </div>
      </div>

      <div>
        <div class="stat-carousel relative h-32">
          {stats.map((stat, index) => (
            <div class:list={["stat-slide absolute inset-0 flex flex-col items-end justify-center text-right", { "is-active": index === 0 }]} data-index={index}>
              <p class="stat-number text-5xl font-bold text-accent md:text-6xl" data-target={stat.value} data-suffix={stat.suffix}>{`0${stat.suffix}`}</p>
              <p class="mt-3 text-sm text-muted">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- MEGKERESÉS -->
  <section class="bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">A megkeresés</span>
          <h2 class="mt-2 text-2xl font-bold text-white">Egy vizuálisan erős cég, ami alulmúlta önmagát</h2>
        </div>
        <div class="space-y-4 text-muted">
          <p>
            András, az iDekor vezetője keresett meg minket azzal, hogy a cég weboldalát
            szeretné megújítani. Az iDekor egy reklámkivitelező cég, amely komplex
            szolgáltatást nyújt a tervezéstől a gyártáson át a helyszíni kivitelezésig —
            táblákat, fóliákat, üzletdekorációt, autófóliázást és 3D feliratokat
            készítenek. Egy ilyen, vizuálisan erős szakmai háttérrel rendelkező cégnél
            különösen fontos, hogy a weboldal is ezt a színvonalat közvetítse — ezzel
            szemben a meglévő oldal ezt egyáltalán nem tudta teljesíteni.
          </p>
          <p>
            Összesen több mint 35 aloldalt újítottunk meg a projekt során — ez
            gyakorlatilag a teljes weboldal tartalmi és strukturális átdolgozását
            jelentette, aloldalanként egyedi tartalommal és felépítéssel.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLÉMÁK - KÁRTYÁK -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">A kiindulási helyzet</span>
      <h2 class="mt-2 text-2xl font-bold text-white">Amivel a régi weboldal küzdött</h2>
      <p class="mt-4 max-w-2xl text-muted">
        András egyértelműen jelezte, hogy a meglévő design alapkoncepciójával elégedett —
        nem egy teljesen új arculatot szeretett volna, hanem annak modernizálását és a
        2026-os elvárásokhoz igazítását.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {problems.map((item) => (
          <div class="flex gap-4 rounded-2xl border border-line bg-base p-5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">{item.title}</h3>
              <p class="mt-1 text-sm text-muted">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TECHNIKAI MEGVALÓSÍTÁS - LÉPÉSEK -->
  <section class="border-t border-line bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">A megvalósítás</span>
      <h2 class="mt-2 text-2xl font-bold text-white">Lépésről lépésre, biztonságosan</h2>
      <p class="mt-4 max-w-2xl text-muted">
        Mivel az oldal élesben futott, és a cégnek folyamatosan érkeztek megkeresések
        rajta keresztül, kiemelten fontos volt, hogy a megújítás ne okozzon kiesést vagy
        törést a meglévő működésben.
      </p>

      <div class="relative mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="absolute left-0 right-0 top-6 hidden h-px bg-line lg:block"></div>
        {steps.map(([num, title, text]) => (
          <div class="relative">
            <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border border-line bg-base text-sm font-bold text-accent">
              {num}
            </div>
            <h3 class="mt-4 font-semibold text-white">{title}</h3>
            <p class="mt-2 text-sm text-muted">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO - KIEMELT BLOKK -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="rounded-3xl border border-accent/30 bg-base p-8 sm:p-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-accent">Technikai SEO-alapozás</span>
        <h2 class="mt-2 text-2xl font-bold text-white">A design mellett a láthatóság is</h2>
        <ul class="mt-6 space-y-3">
          {seoTasks.map((text) => (
            <li class="flex items-start gap-3 text-sm text-white/90">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
              {text}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ÖSSZEGZÉS -->
  <section class="bg-base py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="border-l-2 border-accent pl-6 text-xl font-medium leading-relaxed text-white">
        „A legnagyobb érték abban rejlik, ahogyan a háttérben, kontrollált, lépésről
        lépésre haladó technikai munkával biztonságosan modernizálunk egy élesben futó,
        ügyfeleket kiszolgáló weboldalt."
      </p>
      <p class="mt-6 text-muted">
        A projekt mindössze néhány hete zárult le, így a keresőoptimalizálási eredmények
        (pozíciók, organikus forgalom) még nem értékelhetők érdemben — ezekről egy
        későbbi, hosszabb távú mérési időszak után tudunk majd konkrét számokat mondani.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line bg-surface/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="rounded-3xl border border-line bg-base px-8 py-10 text-center sm:px-12">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Neked is elkelne egy hasonló megújítás?</h2>
        <p class="mx-auto mt-3 max-w-md text-sm text-muted">
          Kérj egy ingyenes állapotfelmérést és árajánlatot — 24 órán belül jelentkezünk.
        </p>
        <a href="/#ajanlatkeres" class="mt-6 inline-block rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 ease-out hover:shadow-[0_0_25px_5px_rgba(255,77,46,0.35)]">
          Ingyenes árajánlatot kérek
        </a>
      </div>
    </div>
  </section>

  <script>
    const carousel = document.querySelector('.stat-carousel');
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll('.stat-slide'));
      let current = 0;

      function countUp(slide) {
        const numberEl = slide.querySelector('.stat-number');
        const target = parseInt(numberEl.dataset.target, 10);
        const suffix = numberEl.dataset.suffix || '';
        const duration = 3000;
        let start = null;

        function step(timestamp) {
          if (!start) start = timestamp;
          const progress = Math.min((timestamp - start) / duration, 1);
          const value = Math.floor(progress * target);
          numberEl.textContent = value + suffix;
          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            numberEl.textContent = target + suffix;
          }
        }
        requestAnimationFrame(step);
      }

      function goTo(index) {
        const currentSlide = slides[current];
        const nextSlide = slides[index];

        currentSlide.classList.remove('is-active');
        currentSlide.classList.add('is-exiting');
        nextSlide.classList.add('is-active');
        countUp(nextSlide);

        setTimeout(() => {
          currentSlide.classList.remove('is-exiting');
          currentSlide.querySelector('.stat-number').textContent = '0' + currentSlide.querySelector('.stat-number').dataset.suffix;
        }, 600);

        current = index;
      }

      countUp(slides[0]);

      setInterval(() => {
        goTo((current + 1) % slides.length);
      }, 5000);
    }
  </script>
</Layout>