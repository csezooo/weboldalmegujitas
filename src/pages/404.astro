---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Az oldal nem található | Weboldalmegújítás">
  <section class="flex min-h-[70vh] items-center bg-base py-40">
    <div class="mx-auto max-w-xl px-6 text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">404</span>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Ez az oldal nem található</h1>
      <p class="mt-5 text-muted">
        Úgy tűnik, ez az oldal nem létezik, vagy elköltözött. Nézd meg a főoldalunkat, vagy
        vedd fel velünk a kapcsolatot.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 ease-out hover:shadow-[0_0_25px_5px_rgba(255,77,46,0.35)]">
          Vissza a főoldalra
        </a>
        <a href="/kapcsolat" class="rounded-full border border-line px-7 py-3.5 text-sm font-semibold text-white transition-colors duration-300 ease-out hover:border-white/40">
          Kapcsolat
        </a>
      </div>
    </div>
  </section>
</Layout>