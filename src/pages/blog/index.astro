---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = posts;
const dateFormatter = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Blog | Weboldalmegújítás"
  description="Tippek, útmutatók és gondolatok weboldal-megújításról, SEO-ról és online jelenlétről."
>
  <section class="relative overflow-hidden border-b border-line bg-base py-24">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-accent/15 blur-[120px]"></div>

    <div class="relative mx-auto max-w-4xl px-6 text-center" data-reveal>
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">Minden, ami a weboldalak megújításával kapcsolatos</span>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Blog</h1>
      <p class="mx-auto mt-4 max-w-xl text-muted">
        Írásaink weboldal-megújításról, SEO-ról és arról, hogyan hozzon a weboldalad
        valódi ügyfeleket.
      </p>
    </div>
  </section>

  <section class="bg-base py-24">
    <div class="mx-auto max-w-5xl px-6">
      {featured && (
        <a
          href={`/blog/${featured.id}`}
          class="group block overflow-hidden rounded-3xl border border-line bg-surface transition-all duration-500 ease-out hover:border-accent/40"
          data-reveal
        >
          <div class="grid gap-8 p-8 sm:p-10 md:grid-cols-[1fr_auto] md:items-center">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Legfrissebb írás</span>
              <h2 class="mt-3 text-2xl font-bold text-white transition-colors duration-300 ease-out group-hover:text-accent-soft sm:text-3xl">
                {featured.data.title}
              </h2>
              <p class="mt-3 max-w-xl text-muted">{featured.data.description}</p>
              <div class="mt-6 flex items-center gap-4 text-xs text-muted">
                <span>{dateFormatter.format(featured.data.pubDate)}</span>
                <span>·</span>
                <span>{featured.data.readingTime}</span>
              </div>
            </div>
            <div class="hidden shrink-0 items-center justify-center rounded-full border border-line bg-base p-4 transition-all duration-500 ease-out group-hover:translate-x-1 group-hover:border-accent/50 md:flex">
              <svg class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.3 3.3a1 1 0 011.4 0l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4L13.6 10 10.3 6.7a1 1 0 010-1.4z" clip-rule="evenodd" /></svg>
            </div>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="mt-16 grid gap-6 sm:grid-cols-2">
          {rest.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col rounded-2xl border border-line bg-surface p-6 transition-all duration-500 ease-out hover:-translate-y-1 hover:border-accent/40"
              data-reveal
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">{post.data.category}</span>
              <h3 class="mt-3 text-xl font-semibold text-white transition-colors duration-300 ease-out group-hover:text-accent-soft">
                {post.data.title}
              </h3>
              <p class="mt-2 flex-1 text-sm text-muted">{post.data.description}</p>
              <div class="mt-5 flex items-center justify-between text-xs text-muted">
                <span>{dateFormatter.format(post.data.pubDate)}</span>
                <span>{post.data.readingTime}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>